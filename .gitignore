# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secrets / tokens
.dev.vars
.vercel-token

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# SQLite temp files
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3.backup-*

# Temp/backup data files
.tmp-order-ai.xlsx

# Vercel Build Output
.vercel

# Vercel trigger/cache files
.vercel-cache-bust
.vercel-deploy-trigger
.vercel-deployment-trigger
.vercel-rebuild-*
.vercel-trigger

# Development logs
dev-*.log
core
test-scripts/

nul

# Python packages (runtime install)
.python_packages/

# Local backups / temp data (secret leak 방지)
/backups/
/supabase/.temp/
/output/tasting-notes/*.pptx
/output/tasting-notes/*.pdf

# Claude Code worktrees (토큰/히스토리 잔존 위험)
/.claude/worktrees/

# bkit 런타임 상태 (재생성 가능, 공유 불필요)
/.bkit/runtime/
/.bkit/snapshots/

# Agent state / memory
/.agents/.claude/skills/*/state/

# Expo (로컬 dev 로그에 시크릿 포함 가능 — 절대 커밋 금지)
.expo/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
